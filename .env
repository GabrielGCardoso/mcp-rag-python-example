EMBED_BACKEND=ollama
# EMBED_BACKEND=local
LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SQLITE_PATH=data/index.sqlite
SOURCES_FILE=sources.yaml

# Opcional. EMBED_BACKEND=ollama fala com o binário nativo, sem Docker.
OLLAMA_BASE_URL=http://localhost:11435
OLLAMA_EMBED_MODEL=nomic-embed-text

# Opcional. Sem valor, o chunk fica em 500 caracteres.
EMBED_NUM_CTX=

MCP_TRANSPORT=streamable-http
# MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
