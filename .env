EMBED_BACKEND=local
LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SQLITE_PATH=data/index.sqlite
SOURCES_FILE=sources.yaml

# Opcional. EMBED_BACKEND=ollama fala com o binário nativo, sem Docker.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# Vazio: a tool ask não é registrada.
OLLAMA_CHAT_MODEL=

# Opcionais. Sem valor, o chunk fica em 500 caracteres e o Ollama usa o default da tag.
EMBED_NUM_CTX=
OLLAMA_NUM_CTX=
OLLAMA_NUM_PREDICT=

MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
